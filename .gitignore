# Python
.venv/
__pycache__/
*.pyc
*.egg-info/

# Builds
build/
dist/
*.spec

# Secrets / local state
.env
.opencode-home/

# Tooling caches (carried over from the reference repo)
.memsearch/
.ckb/

# macOS
.DS_Store

# User data. The example apps write real content here when run — job records,
# extracted profiles, wiki notes, browser profiles. Directory structure is kept
# via .gitkeep; nothing inside it belongs in a public repository.
# (The previous `apps\*\workspace` entry used backslashes and never matched.)
workspace/
apps/*/workspace/*
!apps/*/workspace/*/
!apps/*/workspace/**/.gitkeep

# Personal scratch — drafts, profile blurbs. Not part of the project.
*_PROJECT_BLURB.md
CLAUDE.md
AGENTS.md
.codex-artifacts
.pytest_cache
.ruff_cache
.claude
